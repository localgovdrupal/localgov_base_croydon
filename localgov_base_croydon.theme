<?php

/**
 * @file
 * Theme hooks to support the LocalGov Base Croydon theme.
 */

/**
 * Implements hook_theme_registry_alter().
 *
 * Ensures Croydon template overrides take precedence over copies shipped in
 * vendor/localgovdrupal/localgov_base (which Drupal would otherwise prefer).
 */
function localgov_base_croydon_theme_registry_alter(array &$theme_registry): void {
  $custom_templates = localgov_base_croydon_get_custom_template_paths();
  $vendor_prefix = localgov_base_croydon_get_vendor_template_prefix();

  foreach ($theme_registry as &$info) {
    if (!isset($info['template'], $info['path'])) {
      continue;
    }
    if (!str_starts_with($info['path'], $vendor_prefix)) {
      continue;
    }

    $filename = $info['template'] . '.html.twig';
    if (isset($custom_templates[$filename])) {
      $info['path'] = $custom_templates[$filename];
    }
  }
}

/**
 * Returns custom Twig template directories keyed by filename.
 *
 * @return array<string, string>
 *   Template filenames mapped to theme-relative directory paths.
 */
function localgov_base_croydon_get_custom_template_paths(): array {
  static $custom_templates;

  if ($custom_templates !== NULL) {
    return $custom_templates;
  }

  $custom_templates = [];
  $theme_path = \Drupal::service('extension.list.theme')->getPath('localgov_base_croydon');
  $templates_dir = DRUPAL_ROOT . '/' . $theme_path . '/templates';

  if (!is_dir($templates_dir)) {
    return $custom_templates;
  }

  $finder = new \Symfony\Component\Finder\Finder();
  $finder->files()->in($templates_dir)->name('*.html.twig');

  foreach ($finder as $file) {
    $custom_templates[$file->getFilename()] = $theme_path . '/templates/' . $file->getRelativePath();
  }

  return $custom_templates;
}

/**
 * Theme-relative path prefix for vendor-provided localgov_base templates.
 */
function localgov_base_croydon_get_vendor_template_prefix(): string {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('localgov_base_croydon');

  return $theme_path . '/vendor/';
}

/**
 * Audits custom template overrides against vendor copies.
 *
 * @return array<int, array<string, mixed>>
 *   Conflict rows for templates that exist in both locations.
 */
function localgov_base_croydon_audit_template_overrides(): array {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('localgov_base_croydon');
  $custom_base = DRUPAL_ROOT . '/' . $theme_path . '/templates';
  $vendor_base = DRUPAL_ROOT . '/' . $theme_path . '/vendor/localgovdrupal/localgov_base/templates';
  $custom_templates = localgov_base_croydon_get_custom_template_paths();
  $registry = \Drupal::service('theme.registry')->get();
  $vendor_prefix = localgov_base_croydon_get_vendor_template_prefix();
  $rows = [];

  if (!is_dir($vendor_base)) {
    return $rows;
  }

  $vendor_files = [];
  $finder = new \Symfony\Component\Finder\Finder();
  $finder->files()->in($vendor_base)->name('*.html.twig');
  foreach ($finder as $file) {
    $vendor_files[$file->getFilename()] = $file->getRelativePathname();
  }

  foreach ($custom_templates as $filename => $custom_path) {
    if (!isset($vendor_files[$filename])) {
      continue;
    }

    $custom_rel = '';
    $custom_finder = new \Symfony\Component\Finder\Finder();
    $custom_finder->files()->in($custom_base)->name($filename);
    foreach ($custom_finder as $file) {
      $custom_rel = $file->getRelativePathname();
    }

    $active_path = NULL;
    $active_hook = NULL;
    $template = pathinfo($filename, PATHINFO_FILENAME);
    foreach ($registry as $hook => $info) {
      if (($info['template'] ?? '') === $template && str_starts_with($info['path'] ?? '', $theme_path)) {
        $active_path = $info['path'];
        $active_hook = $hook;
      }
    }

    $rows[] = [
      'filename' => $filename,
      'custom' => 'templates/' . $custom_rel,
      'vendor' => 'vendor/localgovdrupal/localgov_base/templates/' . $vendor_files[$filename],
      'identical' => md5_file($custom_base . '/' . $custom_rel) === md5_file($vendor_base . '/' . $vendor_files[$filename]),
      'hook' => $active_hook,
      'active_path' => $active_path,
      'vendor_wins' => $active_path && str_starts_with($active_path, $vendor_prefix),
    ];
  }

  return $rows;
}

/**
 * Implements hook_preprocess_html().
 *
 * Adds a unique body class for the "How to contact us" page.
 *
 * Note: the "subsite-extra" / "subsite-extra--color-*" body classes are added
 * for every page within a subsite by localgov_subsites_extras_preprocess_html()
 * (driven by the subsite_class / theme_class_prefix settings), so they must not
 * be hardcoded here.
 */
function localgov_base_croydon_preprocess_html(array &$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');

  if ($node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 7907) {
    $variables['attributes']['class'][] = 'page-how-contact-us';
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * When a subsite-extra page has no section navigation links, keep the main
 * content in a two-thirds column with a one-third gap on the right.
 */
function localgov_base_croydon_preprocess_page(array &$variables): void {
  $request = \Drupal::request();
  if (!$request->attributes->get('localgov_base_croydon_subsite_nav_is_extra')) {
    return;
  }

  if ($request->attributes->get('localgov_base_croydon_subsite_nav_has_section_links', TRUE)) {
    return;
  }

  // Force the content-left layout even if sidebar_first still appears to have
  // content (e.g. an empty navigation block wrapper with contextual links).
  $variables['has_sidebars'] = TRUE;
  $variables['has_sidebar_first'] = FALSE;
  $variables['has_sidebar_second'] = TRUE;
}

/**
 * Implements hook_preprocess_block() for hook_preprocess_block__localgov_base_croydon_subsitebanner_homepage().
 *
 * Makes the render array for the *banner image path* available to the block
 * template.
 */
function localgov_base_croydon_preprocess_block__localgov_base_croydon_subsitebanner_homepage(&$variables) {

  $banner_paragraph = $variables['content']['#paragraph'];
  $has_no_banner_img = !($banner_paragraph->localgov_image and $banner_paragraph->localgov_image->count());
  if ($has_no_banner_img) {
    $variables['banner_img_url'] = '';
    return;
  }
  $banner_img = $banner_paragraph->localgov_image->entity;
  $banner_img_url = Drupal::service('entity_type.manager')->getViewBuilder($banner_img->getEntityTypeId())->view($banner_img, 'cds_image_path');
  $variables['banner_img_url'] = $banner_img_url;
}

/**
 * Implements hook_preprocess_node() for hook_preprocess_node__localgov_guides_page().
 *
 * - Sets Guide page content width.
 */
function localgov_base_croydon_preprocess_node__localgov_guides_overview__full(&$variables) {

  $variables['attributes']['class'][] = 'lgd-row__two-thirds';
}

/**
 * Implements hook_preprocess_node() for hook_preprocess_node__localgov_guides_page().
 *
 * - Sets Guide page content width.
 */
function localgov_base_croydon_preprocess_node__localgov_guides_page__full(&$variables) {

  $variables['attributes']['class'][] = 'lgd-row__two-thirds';
}

/**
 * Hides label from "Plain address" view mode of Geo.
 */
function localgov_base_croydon_preprocess_geo_entity__cds_plain_address(&$variables) {
  $variables['content']['label'] = NULL;
}

/**
 * See above.
 */
function localgov_base_croydon_preprocess_localgov_geo__cds_plain_address(&$variables) {
  localgov_base_croydon_preprocess_geo_entity__cds_plain_address($variables);
}

/**
 * Implements hook_preprocess_paragraph().
 *
 * Changes:
 * Adds a variable to determinse if the box links are
 * on the home page.
 *
 * @see localgov_base_croydon_preprocess_paragraph__localgov_box_link()
 */
function localgov_base_croydon_preprocess_paragraph__localgov_box_link(&$variables) {
  $paragraph = $variables['paragraph'];
  if ($paragraph->bundle() === 'localgov_box_link') {
    $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  }
}

/**
 * Prepares variables for webform submission data templates.
 */
function localgov_base_croydon_preprocess_webform_submission_data(array &$variables) {

  // Completed Form.
  $completed_form = [];
  $completed_form = $variables["elements"]["data"];
  foreach ($completed_form as $page_key => $page_value) {

    // Are the elelemnts on a wizard page?
    // Set up the array keys.
    // - Wizard page key.
    // - Webfom element key.
    if (isset($page_value["#value"]['#children'])) {
      $webform_element_key = array_key_first($page_value["#value"]['#children']);
    }


    if (isset($page_value['#element']['#webform_key'])) {
      $webform_wizard_page_key = $page_value['#element']['#webform_key'];
    }

    // Page title.
    $webform_wizard_page_title = $page_value['#element']['#title'];

    // Form Data - Label.

    // Webform wizard page link.
    // The Edit summary button.
    if (isset($page_value["#value"]['#children']) && array_key_exists('wizard_page_link', $page_value["#value"]['#children'])) {
      $webform_wizard_page_link = $page_value["#value"]['#children']['wizard_page_link'];
    }

    // Filter out Form elements
    // Get the webform elements.
    // Anything in the array that is not preceded with a '#'
    // we assume is a webform element.
    $webform_element = [];
    $webform_element_value = NULL;

    foreach (array_keys($page_value['#element']) as $element_setting_key => $element_setting_value) {
      if("#" !== substr($element_setting_value, 0, 1)) {
        $webform_element[$element_setting_value]['label'] =  $page_value['#element'][$element_setting_value]['#title'];
        $webform_element[$element_setting_value]['value'] =  $page_value['#value']['#children'][$element_setting_value]['#value'];
      }

      // Check that the webform element's value is not empty
      // If it's empty remove the element.
      if ($webform_element[$element_setting_value]['value'] == null ) {
        unset($webform_element[$element_setting_value]);
      }

      // Check if the webform element has a key called 'actions'.
      // The 'action' array key will be the form submit button.
      if (array_key_exists('actions', $webform_element)) {
        unset($webform_element['actions']);
      }

      $webform_element_value = $webform_element;
    }

    // Check if this is a fieldset that has form elements in it.
    // Form Data - Fieldset.
    $webform_fieldset_element = [];
    $webform_fieldset_element = NULL;

    if (isset($webform_element_value[$webform_element_key]['value']["#type"]) &&
      $webform_element_value[$webform_element_key]['value']['#type'] == 'fieldset' &&
      $webform_element_value[$webform_element_key]['value']['#children'] != NULL ) {

      $webform_fieldset_element = [];
      // Fieldset label
      if (isset($webform_element_value['value'])  && $webform_element_value['value'] != NULL ) {

        foreach ($webform_element_value['value']['#children'] as $element_key => $element_value) {
          $webform_fieldset_element[$element_key]['fieldset_label'] = $webform_element['title'];
          $webform_fieldset_element[$element_key]['label'] = $element_value['#element']['#title'];
          $webform_fieldset_element[$element_key]['value'] = $element_value['#value'];

          // Copy Webform fieldset element.
          $webform_element_value = $webform_fieldset_element;
        }

      }

    }
    $completed_form[$page_key]['#summary']['page_key'] = $webform_wizard_page_key;
    $completed_form[$page_key]['#summary']['page_title'] = $webform_wizard_page_title;
    // $completed_form[$page_key]['#summary']['label'] = $webform_element_label;
    $completed_form[$page_key]['#summary']['value'] = $webform_element_value;
    $completed_form[$page_key]['#summary']['wizard_page_link'] = $webform_wizard_page_link;

  }
  $variables["elements"]["data"] = $completed_form;

}

/** * Implements hook_preprocess_hook() for hook_preprocess_node__cds_tenancy_office_dir_page__cds_definition_list.
 *
 * Provides localgov_location twice.  This is for ease of styling the
 * location map.
 */
function localgov_base_croydon_preprocess_node__cds_tenancy_office_dir_page__cds_definition_list(&$variables) {

  if (isset($variables['content']['localgov_location'])) {
    $variables['content']['localgov_location_copy'] = $variables['content']['localgov_location'];
  }

  if (isset($variables['content']['localgov_location']['#third_party_settings']['field_formatter_class'])) {
    $variables['content']['localgov_location']['#third_party_settings']['field_formatter_class']['class'] .= ' localgov_location_original';
    $variables['content']['localgov_location_copy']['#third_party_settings']['field_formatter_class']['class'] .= ' localgov_location_copy';
  }
}

/**
 * Implements hook_preprocess_block().
 *
 * Hides the Table of Contents (TOC) block on specific Publication outline pages.
 *
 * This function checks if the current page belongs to a Book hierarchy and
 * removes the block if the node is either a parent (that has child pages) or a child
 */
function localgov_base_croydon_preprocess_block(array &$variables) {
  if ($variables['plugin_id'] === 'localgov_publications_toc_block') {
    $route_match = \Drupal::service('current_route_match');
    $node = $route_match->getParameter('node');

    if ($node instanceof \Drupal\node\NodeInterface) {
      // Hide block if it's a book parent or child
      if (!empty($node->book['has_children']) || !empty($node->book['pid'])) {
        $variables['hide_block'] = TRUE;
      }
    }
  }
}

/**
 * Implements hook_preprocess_field() to customize file links on
 * localgov_publication_cover_page nodes for the field_media_document.
 */
function localgov_base_croydon_preprocess_field(array &$variables, string $hook): void {
  if ($variables['element']['#field_name'] === 'field_media_document' &&
      $variables['element']['#entity_type'] === 'media' &&
      $variables['element']['#bundle'] === 'document') {
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface && $node->getType() === 'localgov_publication_cover_page') {
      foreach ($variables['items'] as &$item) {
        if (isset($item['content']['#theme']) && $item['content']['#theme'] === 'file_link') {
          $item['content']['#theme'] = 'file_link__node__localgov_publication_cover_page';
        }
      }
    }
  }

  // On standard subsites the banner text field just repeats the page title, so
  // hide it entirely. Extra subsites use this field as a genuine banner
  // subtitle, so it's left untouched there: getCurrentSubsiteTheme() returns a
  // theme string for extra subsites and NULL for standard subsites.
  if ($variables['element']['#field_name'] === 'localgov_subsites_banner_text') {
    $theme = \Drupal::service('localgov_subsites_extras.service')->getCurrentSubsiteTheme();
    if ($theme === NULL) {
      $variables['items'] = [];
    }
    // Result depends on which subsite (and therefore theme) the page belongs to.
    $variables['#cache']['contexts'][] = 'subsites.theme';
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * This function targets 'localgov_subsites_page' nodes in 'full' view mode
 * to determine if banner content exists (since the banner itself always exists) and pass this
 * information to the Twig template.
 */
function localgov_base_croydon_preprocess_node__localgov_subsites_page__full(&$variables) {
  $node = $variables['node'];
  $has_banner_meaningful_content = FALSE;

  if ($node->hasField('localgov_subsites_banner') && !$node->get('localgov_subsites_banner')->isEmpty()) {
    $first_item = $node->get('localgov_subsites_banner')->first();

    if ($first_item) {
      // Try to load the paragraph entity
      $banner_paragraph = $first_item->entity;
      if (!$banner_paragraph && $first_item->target_id) {
        $banner_paragraph = \Drupal\paragraphs\Entity\Paragraph::load($first_item->target_id);
      }

      if ($banner_paragraph && $banner_paragraph instanceof \Drupal\paragraphs\ParagraphInterface) {
        $banner_image_has_content = FALSE;
        $banner_title_has_content = FALSE;
        $banner_text_has_content = FALSE;

        // Image check
        if ($banner_paragraph->hasField('localgov_image') && !$banner_paragraph->get('localgov_image')->isEmpty() && $banner_paragraph->get('localgov_image')->target_id) {
          $file = \Drupal\file\Entity\File::load($banner_paragraph->get('localgov_image')->target_id);
          if ($file) {
            $banner_image_has_content = TRUE;
          }
        }

        // Title check
        if ($banner_paragraph->hasField('localgov_title') && !$banner_paragraph->get('localgov_title')->isEmpty()) {
          $title_value = $banner_paragraph->get('localgov_title')->value;
          $clean_title = trim(strip_tags(html_entity_decode($title_value)));
          if ($clean_title !== '') {
            $banner_title_has_content = TRUE;
          }
        }

        // Text check
        if ($banner_paragraph->hasField('localgov_subsites_banner_text') && !$banner_paragraph->get('localgov_subsites_banner_text')->isEmpty()) {
          $text_value = $banner_paragraph->get('localgov_subsites_banner_text')->value;
          if (is_array($text_value) && isset($text_value['value'])) {
            $text_value = $text_value['value'];
          }
          $clean_text = trim(strip_tags(html_entity_decode($text_value)));
          if ($clean_text !== '') {
            $banner_text_has_content = TRUE;
          }
        }

        $has_banner_meaningful_content = $banner_image_has_content || $banner_title_has_content || $banner_text_has_content;
      }
    }
  }

  $variables['has_banner_meaningful_content'] = $has_banner_meaningful_content;
}

/**
 * Implements hook_preprocess_HOOK() for subsite_navigation.
 *
 * Scopes the subsite sidebar navigation to the currently active section.
 *
 * The navigation tree passed to the template starts at the subsite overview
 * (items[0]); its children are the top level "sections" shown in the main
 * subsite menu. We work out which of those sections the current page belongs to
 * (matching on node id, as the tree's built-in in_active_trail flag is only ever
 * set for the overview root) so the template can:
 * - use the section name as the heading,
 * - list only the pages within that section,
 * - and, when viewing a page below the section, link the heading back to the
 *   section landing page.
 */
function localgov_base_croydon_preprocess_subsite_navigation(&$variables) {
  $items = $variables['items'] ?? [];
  $current = $variables['current_entity'] ?? NULL;

  $overview_item = $items[0] ?? NULL;
  if ($overview_item === NULL) {
    return;
  }

  $current_id = ($current instanceof \Drupal\node\NodeInterface) ? (string) $current->id() : NULL;

  // The "section" scoping (heading = section, list = that section's children)
  // only applies to subsite-extra style subsites, whose overview is one of the
  // configured subsite_types (e.g. cds_subsite_homepage). Standard subsites use
  // the overview root as the section on every page, so the sidebar always lists
  // the whole subsite - matching the original behaviour.
  $overview_entity = $variables['overview_entity'] ?? NULL;
  $subsite_types = \Drupal::config('localgov_subsites_extras.settings')->get('subsite_types') ?: [];
  $is_extra_subsite = $overview_entity instanceof \Drupal\node\NodeInterface
    && in_array($overview_entity->bundle(), $subsite_types, TRUE);

  // Find the section (direct child of the overview) whose subtree contains the
  // current page. Fall back to the overview itself (e.g. on the overview page,
  // for standard subsites, or when the current page cannot be located).
  $section = $overview_item;
  if ($is_extra_subsite && $current_id !== NULL) {
    foreach ($overview_item['below'] ?? [] as $candidate) {
      if (
        localgov_base_croydon_subsite_nav_item_node_id($candidate) === $current_id ||
        localgov_base_croydon_subsite_nav_subtree_has_node($candidate, $current_id)
      ) {
        $section = $candidate;
        break;
      }
    }
  }

  // Flag the current page and its active trail within the section so the
  // template can render the current page as plain text and, for standard
  // subsites, expand only the pages in the active trail.
  if ($current_id !== NULL && !empty($section['below'])) {
    localgov_base_croydon_subsite_nav_mark_trail($section['below'], $current_id);
  }

  // We are on the section landing page when the current page is the section
  // itself; otherwise the heading should link back to the section landing page.
  $variables['is_extra_subsite'] = $is_extra_subsite;
  $variables['section'] = $section;
  $variables['on_section_landing'] = $current_id === NULL
    || localgov_base_croydon_subsite_nav_item_node_id($section) === $current_id;

  $request = \Drupal::request();
  $request->attributes->set('localgov_base_croydon_subsite_nav_is_extra', $is_extra_subsite);
  $request->attributes->set('localgov_base_croydon_subsite_nav_has_section_links', !empty($section['below']));
}

/**
 * Flags the current page and the active trail within a navigation subtree.
 *
 * Sets two flags on each item:
 * - is_current: TRUE when the item is the page currently being viewed.
 * - in_trail: TRUE when the item is the current page or an ancestor of it.
 *
 * @param array $items
 *   A list of subsite navigation menu items, passed by reference.
 * @param string|int $current_id
 *   The node id of the current page.
 *
 * @return bool
 *   TRUE if the current page was found within this list or its descendants.
 */
function localgov_base_croydon_subsite_nav_mark_trail(array &$items, $current_id): bool {
  $trail_present = FALSE;

  foreach ($items as &$item) {
    $is_current = localgov_base_croydon_subsite_nav_item_node_id($item) === $current_id;

    $child_in_trail = FALSE;
    if (!empty($item['below'])) {
      $child_in_trail = localgov_base_croydon_subsite_nav_mark_trail($item['below'], $current_id);
    }

    $item['is_current'] = $is_current;
    $item['in_trail'] = $is_current || $child_in_trail;
    $trail_present = $trail_present || $item['in_trail'];
  }

  return $trail_present;
}

/**
 * Returns the node id referenced by a subsite navigation item, if any.
 *
 * @param array $item
 *   A subsite navigation menu item.
 *
 * @return string|int|null
 *   The referenced node id, or NULL if the item has no node route.
 */
function localgov_base_croydon_subsite_nav_item_node_id(array $item) {
  if (isset($item['url']) && $item['url'] instanceof \Drupal\Core\Url && $item['url']->isRouted()) {
    $node_id = $item['url']->getRouteParameters()['node'] ?? NULL;
    return $node_id === NULL ? NULL : (string) $node_id;
  }

  return NULL;
}

/**
 * Determines whether a node id appears anywhere below a navigation item.
 *
 * @param array $item
 *   A subsite navigation menu item.
 * @param string|int $node_id
 *   The node id to search for.
 *
 * @return bool
 *   TRUE if the node id is found in the item's descendants.
 */
function localgov_base_croydon_subsite_nav_subtree_has_node(array $item, $node_id): bool {
  foreach ($item['below'] ?? [] as $child) {
    if (localgov_base_croydon_subsite_nav_item_node_id($child) === $node_id) {
      return TRUE;
    }
    if (localgov_base_croydon_subsite_nav_subtree_has_node($child, $node_id)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_preprocess_form_element().
 *
 * Adjusts the label for LocalGov form date elements so that they
 * display a label of "Day", "Month", or "Year" based on the
 * element's class suffix.
 */
function localgov_base_croydon_preprocess_form_element(&$variables) {
  if (!empty($variables['element']['#attributes']['class'])) {
    $suffix_map = [
      '_day' => \Drupal::translation()->translate('Day'),
      '_month' => \Drupal::translation()->translate('Month'),
      '_year' => \Drupal::translation()->translate('Year'),
    ];
    foreach ($variables['element']['#attributes']['class'] as $class) {
      // Check if the class is a LocalGov forms date class.
      // If it is, check for the suffix and update the label accordingly.
      if (strpos($class, 'localgov_forms_date_') !== FALSE) {
        foreach ($suffix_map as $suffix => $label) {
          if (str_contains($class, $suffix)) {
            if (isset($variables['label']['#title'])) {
              $variables['label']['#title'] = $label;
            }
            break 2;
          }
        }
      }
    }
  }
}
