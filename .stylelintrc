{
  "ignoreFiles": [
    "assets/scss/lib/partials/_google-search.scss",
    "assets/scss/lib/partials/_design-system.scss",
    "assets/scss/lib/_functions.scss",
    "assets/scss/lib/_variables-croydon.scss",
    "assets/scss/lib/vendor/*"
  ],
  "extends": "stylelint-config-standard",
  "plugins": [
    "stylelint-scss"
  ],
  "rules": {
    "declaration-colon-newline-after": null,
    "no-descending-specificity": null,
    "number-leading-zero": null,
    "selector-pseudo-element-colon-notation": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["extends", "ignores", "mixin", "include"]
      }
    ],
    "block-closing-brace-newline-before": null,
    "block-no-empty": true,
    "color-no-invalid-hex": true,
    "selector-list-comma-newline-after": "always",
    "comment-empty-line-before": [ "always", {
      "ignore": ["stylelint-commands", "after-comment"]
    } ],
    "declaration-no-important": true,
    "function-calc-no-invalid": true,
    "function-no-unknown": true,
    "length-zero-no-unit": true,
    "max-empty-lines": 1,
    "max-line-length": 80,
    "no-duplicate-selectors": true,
    "no-empty-source": true,
    "no-extra-semicolons": true,
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": ["composes"]
      }
    ],
    "selector-max-id": 0,
    "selector-no-id": true,
    "string-no-newline": true,
    "unit-no-unknown": true,
    "value-no-vendor-prefix": true,
    "declaration-block-no-ignored-properties": true,
    "media-feature-name-no-unknown": true,
    "no-invalid-position-at-import-rule": true,
    "no-unknown-animations": true,
    "order/order": [
      "dollar-variables",
      "declarations",
      "rules"
    ],
    "order/properties-order": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "flex",
      "flex-direction",
      "flex-wrap",
      "justify-content",
      "align-items",
      "align-content",
      "width",
      "height",
      "margin",
      "padding",
      "border",
      "background",
      "color",
      "font",
      "text-align",
      "text-decoration",
      "opacity",
      "transition",
      "transform"
    ],
    "color-no-hex": true,
    "indentation": [2, {
      "except": ["value"]
    }],
    "rule-empty-line-before": [ "always", {
      "except": ["first-nested"],
      "ignore": ["after-comment"]
    } ],
    "unit-allowed-list": ["em", "rem", "%", "s", "deg", "ms", "vh"],
    "selector-class-pattern": null
  }
}
