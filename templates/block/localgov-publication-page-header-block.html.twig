{#
/**
* @file
* Adapted theme implementation of localgov_header_block copied from localgov publications module to 
* add print page functionality.
*
* @see template_preprocess_block()
*
* @ingroup themeable
*/
#}

{% set classes = ['lgd-page-title-block'] %}

<div{{ attributes.addClass(classes) }}>

  <h1 class="lgd-page-title-block__title">
   {% if node_title %}
    <span class="lgd-page-title-block__publication-title">{{ title }}</span>
    <span>
      <span class="visually-hidden"> - </span>
      {{ node_title }}
    </span>
     
    {% else %}
      <span>{{ title }}</span>
    {% endif %}
     
  </h1>
  <div class="lgd-page-title-block__publication-subtitle container pl-0 pb-2 pb-md-0">
      <div class="d-flex flex-column flex-md-row">
          {% if published_date %}
              <div class="lgd-page-title-block__published mb-md-3 mr-md-3">
                  {% trans %}
                      <span>Published:</span> {{ published_date }}
                  {% endtrans %}
              </div>
          {% endif %}

          {% if last_updated_date %}
              <div class="lgd-page-title-block__updated mb-md-3 mr-md-3">
                  {% trans %}
                      <span>Last updated:</span> {{ last_updated_date }}
                  {% endtrans %}
              </div>
          {% endif %}

          <div class="lgd-page-title-block__print">
              <i class="fas fa-print pr-1 pr-md-1" aria-hidden="true"></i>
              <a href="javascript:void(0)" onclick="window.print(); return false;" aria-label="{{ 'Print this page'|t }}">
                <span>{{ 'Print this page'|t }}</span>
              </a>
          </div>
      </div>
  </div>
</div>
