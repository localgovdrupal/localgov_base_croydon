{#
/**
 * @file
 * Theme subsites navigation menu - based on menu.html.twig.
 *
 * The sidebar navigation is scoped to the subsite section the current page
 * belongs to (the same section highlighted in the main subsite menu,
 * .subsite-extra-menu):
 * - The section name is used as the heading instead of a generic label.
 * - Only pages that belong to the active section are listed.
 * - When viewing a page below the section, the heading links back to the
 *   section landing page.
 *
 * The active section (`section`) and whether we are on its landing page
 * (`on_section_landing`) are worked out in
 * localgov_base_croydon_preprocess_subsite_navigation().
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items, starting from the subsite overview.
 * - section: The menu item for the active section (see preprocess). Contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The section's child items.
 *   - title: The section title.
 *   - url: The section landing page url, instance of \Drupal\Core\Url.
 * - on_section_landing: TRUE when the current page is the section landing page.
 * - current_entity: The node currently being viewed.
 * - overview_entity: The subsite overview (root) node.
 */
#}
{% import _self as subsite_navigation %}

{# Only render the navigation when the section actually has child pages to
   show; otherwise we'd be left with a lone heading and no links. #}
{% if section and section.below is not empty %}
  <ul{{ attributes.addClass('menu') }}>
    <li>
      <h3>
        {% if on_section_landing or section.url is empty %}
          {{ section.title }}
        {% else %}
          {{ link(section.title, section.url) }}
        {% endif %}
      </h3>
    </li>
    {{ subsite_navigation.menu_links(section.below) }}
  </ul>
{% endif %}

{#
  Render the section's descendants. Called for the children of the active
  section; each item that itself has children opens a nested <ul>.
#}
{% macro menu_links(items) %}
  {% import _self as subsite_navigation %}
  {% for item in items %}
    {% if item.url %}
      {%
        set classes = [
          'menu-item',
          item.is_expanded ? 'menu-item--expanded',
          item.is_collapsed ? 'menu-item--collapsed',
          item.in_active_trail ? 'menu-item--active-trail',
        ]
      %}
      <li{{ item.attributes.addClass(classes) }}>
        {% if item.is_current %}
          {# The user is already on this page, so render it as plain text
             (not a link) while keeping the active styling. #}
          <span class="is-active">{{ item.title }}</span>
        {% else %}
          {{ link(item.title, item.url) }}
        {% endif %}
        {% if item.below %}
          <ul class="menu">
            {{ subsite_navigation.menu_links(item.below) }}
          </ul>
        {% endif %}
      </li>
    {% endif %}
  {% endfor %}
{% endmacro %}
